* TIMES.jl crafted case demo12_tsoff (reference/crafted.toml, 18 Nov 2026): dynamic timeslice
* trees (%DYNTS% YES with TS_OFF: timslice.mod L31-39, dynslite.vda; M1.3 change 63). REG1 gets a
* second timeslice tree: a single season A with day and night AD and AN, used in the periods up to
* 2015; the seasons S and W (SD, SN, WD, WN) are used from 2020. AD and AN take the year fractions,
* the load shares (COM_FR) and the availabilities (NCAP_AF, weighted by the year fractions) of the
* day and night slices of S and W together. REG2 keeps its tree.
$ONEMPTY
$ONEPS
$ONWARNING
SET ALL_TS
/
A
AD
AN
/

SET TS_GROUP
/
REG1.SEASON.A
REG1.DAYNITE.AD
REG1.DAYNITE.AN
/

SET TS_MAP
/
REG1.A.AD
REG1.A.AN
/

PARAMETER G_YRFR /
REG1.AD 0.499143835616438
REG1.AN 0.500856164383561
/;

PARAMETER COM_FR /
REG1.2005.DCAP.AD 0.5
REG1.2005.DCAP.AN 0.5
REG1.2005.DCOT.AD 0.5
REG1.2005.DCOT.AN 0.5
REG1.2005.DCSH.AD 0.5
REG1.2005.DCSH.AN 0.5
REG1.2005.DIDM1.AD 0.59
REG1.2005.DIDM1.AN 0.41
REG1.2005.DRAP.AD 0.5
REG1.2005.DRAP.AN 0.45
REG1.2005.DROT.AD 0.5
REG1.2005.DROT.AN 0.5
REG1.2005.DRSH.AD 0.6
REG1.2005.DRSH.AN 0.4
REG1.2005.DTCAR.AD 0.5
REG1.2005.DTCAR.AN 0.5
REG1.2005.DTPUB.AD 0.5
REG1.2005.DTPUB.AN 0.5
/;

PARAMETER NCAP_AF /
REG1.2010.ELCRESOL00.AD.UP 0.3
REG1.2010.ELCRESOL00.AN.UP 0.2
REG1.2010.ELCREWIN00.AD.UP 0.389994282447113
REG1.2010.ELCREWIN00.AN.UP 0.304131054131054
REG1.2010.ELCRNSOL01.AD.UP 0.325014293882218
REG1.2010.ELCRNSOL01.AN.UP 0.25
REG1.2010.ELCRNWIN01.AD.UP 0.409994282447113
REG1.2010.ELCRNWIN01.AN.UP 0.327065527065527
/;

SET TS_OFF
/
REG1.A.2018.2050
REG1.S.2000.2017
REG1.W.2000.2017
/
