REG1.2005.ELCNNNUC01 5
/

PARAMETER
NCAP_DLAG ' '/
REG1.2005.ELCTNOIL01 1
REG1.2005.ELCNNNUC01 2
/

PARAMETER
NCAP_FTAX ' '/
REG1.2005.ELCTNCOA01.MEuro05 5
REG1.2005.ELCTNOIL01.MEuro05 2
REG2.2006.ELCTNGAS01.MEuro05 3
/

PARAMETER
NCAP_FSUB ' '/
REG1.2005.ELCRNWIN01.MEuro05 4
REG1.2005.ELCTNOIL01.MEuro05 1
REG2.2005.ELCRNWIN01.MEuro05 2
/

PARAMETER
NCAP_FOMX ' '/
REG1.2010.ELCTNCOA01 2
REG1.2015.ELCTNCOA01 2
REG1.2020.ELCTNCOA01 2
REG1.2030.ELCTNCOA01 2
REG1.2050.ELCTNCOA01 2
/

PARAMETER
NCAP_FOMM ' '/
REG1.2010.ELCTNCOA01 2
REG1.2015.ELCTNCOA01 2
REG1.2020.ELCTNCOA01 2
REG1.2030.ELCTNCOA01 2
REG1.2050.ELCTNCOA01 2
/

PARAMETER
NCAP_FTAXX ' '/
REG1.2010.ELCTNCOA01 3
REG1.2015.ELCTNCOA01 3
REG1.2020.ELCTNCOA01 3
REG1.2030.ELCTNCOA01 3
REG1.2050.ELCTNCOA01 3
/

PARAMETER
NCAP_FSUBX ' '/
REG1.2010.ELCRNWIN01 2
REG1.2015.ELCRNWIN01 2
REG1.2020.ELCRNWIN01 2
REG1.2030.ELCRNWIN01 2
REG1.2050.ELCRNWIN01 2
/

PARAMETER
NCAP_FSUBM ' '/
REG1.2010.ELCRNWIN01 3
REG1.2015.ELCRNWIN01 3
REG1.2020.ELCRNWIN01 3
REG1.2030.ELCRNWIN01 3
REG1.2050.ELCRNWIN01 3
/

PARAMETER
SHAPE ' '/
2.1 1
2.10 1.2
2.30 1.5
3.1 1
3.20 0.6
/

PARAMETER
MULTI ' '/
2.2005 1
2.2030 1.3
2.2050 1.1
3.2010 0.9
3.2040 1.4
/

PARAMETER
COM_TAXNET ' '/
REG1.2005.ELCCO2.ANNUAL.MEuro05 2
REG2.2005.TRACO2.ANNUAL.MEuro05 1
/

PARAMETER
COM_SUBNET ' '/
REG1.2005.RSDCO2.ANNUAL.MEuro05 0.5
/

PARAMETER
COM_TAXPRD ' '/
REG1.2005.ELC.ANNUAL.MEuro05 0.3
/

PARAMETER
COM_SUBPRD ' '/
REG1.2005.ELC.ANNUAL.MEuro05 0.1
REG2.2005.ELC.ANNUAL.MEuro05 0.05
/

PARAMETER
FLO_TAX ' '/
REG1.2005.ELCTEGAS00.ELCGAS.ANNUAL.MEuro05 0.3
REG1.2005.ELCTEGAS00.ELC.SD.MEuro05 0.4
REG1.2005.ELCTNGAS01.ELCGAS.ANNUAL.MEuro05 0.3
REG1.2005.TU_GAS_REG2_REG1_01.GAS.ANNUAL.MEuro05 0.1
REG1.2005.TU_GAS_REG2_REG1_01.INDCO2.ANNUAL.MEuro05 3
REG1.2005.TB_ELC_REG1_REG2_01.ELC.ANNUAL.MEuro05 0.05
REG2.2005.ELCTECOA00.ELCCOA.ANNUAL.MEuro05 0.2
/

PARAMETER
FLO_SUB ' '/
REG1.2020.ELCTNGAS01.ELCGAS.ANNUAL.MEuro05 0.1
REG1.2030.ELCTNGAS01.ELCGAS.ANNUAL.MEuro05 0.5
REG1.2005.ELCRNWIN01.ELC.ANNUAL.MEuro05 1
REG1.2005.ELCREWIN00.ELC.ANNUAL.MEuro05 0.5
REG2.2005.TB_ELC_REG1_REG2_01.ELC.ANNUAL.MEuro05 0.02
/

PARAMETER
REG_BNDCST ' '/
REG1.2020.INV.MEuro05.UP 1000000
REG1.2030.INV.MEuro05.UP 1000000
REG1.2020.INVTAX.MEuro05.UP 1000000
REG1.2030.INVSUB.MEuro05.LO 1
REG1.2050.INVTAXSUB.MEuro05.UP 1000000
REG1.2030.FOM.MEuro05.UP 1000000
REG1.2030.FOMTAX.MEuro05.UP 1000000
REG1.2020.FOMSUB.MEuro05.UP 1000000
REG1.0.FOMALL.MEuro05.UP 5
REG1.2010.FOMALL.MEuro05.UP 1000000
REG1.2020.COMTAX.MEuro05.UP 1000000
REG1.2020.FLOTAX.MEuro05.UP 1000000
REG1.2030.FLOSUB.MEuro05.UP 1000000
REG2.2015.INVSUB.MEuro05.UP EPS
REG2.2020.COMSUB.MEuro05.UP 1000000
REG2.2030.FIXALL.MEuro05.LO 1
REG2.2030.COMTAX.MEuro05.UP 1000000
/

PARAMETER
REG_CUMCST ' '/
REG1.2012.2034.INV.MEuro05.UP 10000000
