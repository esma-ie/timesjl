* TIMES.jl crafted case demo12_ucattr (reference/crafted.toml, 9 Nov 2026): user-constraint
* attributes (uc_*.mod; M1.3 change 22, docs/m13-plan.md) added to TIMES_Demo demo12
* (etsap-TIMES/TIMES_Demo @ 962db86, CC BY 4.0). No public suite model has them:
* - ATT_PER (EQE_UCRT, REG1): NEWFLO on the flows of the new nuclear plant, made vintaged
*   with a 6-year lead time so an investment is commissioned a period later (RVPT,
*   eqmain.mod L199-201); PERIOD on ACT, NCAP (with RVPT) and COMPRD; BUILDUP on NCAP;
*   CAPACT on CAP; COST on IRE.
* - ATT_COST (EQE_UCRT, REG2): COST, DELIV, TAX and SUB on FLO (a taxed gas input, a
*   subsidised coal input: MAX(0,.) and MIN(0,.) of the net tax); COST on ACT; COST, TAX and
*   SUB on NCAP; TAX on COMNET; COST on COMPRD.
* - ATT_CUM (EQE_UCR, REG1, cumulative over every period): PERDISC on FLO, ACT, COMNET and
*   IRE; EFF on COMNET and COMPRD (ELC has COM_IE 0.9).
* - ATT_CSUM (EQE_UCRSU, REG1): CUMSUM on the RHS NCAP term (ppmain.mod L1160 adds PERIOD),
*   so the CUMSUM entries of UC_TMAP (eqmain.mod L213) are taken.
* - ATT_CUMP (EQE_UCRSU, REG1): SYNC and CUMSUM on the RHS ACT term, which ppmain.mod
*   L1162-1163 turn into CUM+ (eqmain.mod L215).
* The constants are loose, so the model stays feasible.
$ONEMPTY
$ONEPS
$ONWARNING
SET UC_N
/
ATT_PER 'Period and new-flow attributes'
ATT_COST 'Cost attributes'
ATT_CUM 'Cumulative with discounting and efficiencies'
ATT_CSUM 'Capacity against cumulative investment'
ATT_CUMP 'Gas activity against cumulative coal activity'
/

SET PRC_VINT
/
REG1.ELCNNNUC01
/

SET UC_R_EACH
/
REG1.ATT_PER
REG2.ATT_COST
REG1.ATT_CUM
REG1.ATT_CSUM
REG1.ATT_CUMP
/

SET UC_T_SUM
/
REG1.ATT_CUM.2005
REG1.ATT_CUM.2010
REG1.ATT_CUM.2015
REG1.ATT_CUM.2020
REG1.ATT_CUM.2030
REG1.ATT_CUM.2050
/

SET UC_ATTR
/
REG1.ATT_PER.LHS.FLO.NEWFLO
REG1.ATT_PER.LHS.ACT.PERIOD
REG1.ATT_PER.LHS.NCAP.PERIOD
REG1.ATT_PER.LHS.NCAP.BUILDUP
REG1.ATT_PER.LHS.CAP.CAPACT
REG1.ATT_PER.LHS.COMPRD.PERIOD
REG1.ATT_PER.LHS.IRE.COST
REG2.ATT_COST.LHS.FLO.COST
REG2.ATT_COST.LHS.FLO.DELIV
REG2.ATT_COST.LHS.FLO.TAX
REG2.ATT_COST.LHS.FLO.SUB
REG2.ATT_COST.LHS.ACT.COST
REG2.ATT_COST.LHS.NCAP.COST
REG2.ATT_COST.LHS.NCAP.TAX
REG2.ATT_COST.LHS.NCAP.SUB
REG2.ATT_COST.LHS.COMNET.TAX
REG2.ATT_COST.LHS.COMPRD.COST
REG1.ATT_CUM.LHS.FLO.PERDISC
REG1.ATT_CUM.LHS.ACT.PERDISC
REG1.ATT_CUM.LHS.COMNET.PERDISC
REG1.ATT_CUM.LHS.COMNET.EFF
REG1.ATT_CUM.LHS.COMPRD.EFF
REG1.ATT_CUM.LHS.IRE.PERDISC
REG1.ATT_CSUM.RHS.NCAP.CUMSUM
REG1.ATT_CUMP.RHS.ACT.SYNC
REG1.ATT_CUMP.RHS.ACT.CUMSUM
/

PARAMETER
NCAP_ILED ' '/
REG1.2005.ELCNNNUC01 6
/

PARAMETER
FLO_COST ' '/
REG2.2005.ELCTEGAS00.ELCGAS.ANNUAL.MEuro05 0.3
REG1.2005.MINCOA1.COA.ANNUAL.MEuro05 0.1
/

PARAMETER
FLO_DELIV ' '/
REG2.2005.ELCTEGAS00.ELCGAS.ANNUAL.MEuro05 0.1
/

PARAMETER
FLO_TAX ' '/
REG2.2005.ELCTEGAS00.ELCGAS.ANNUAL.MEuro05 0.2
/

PARAMETER
FLO_SUB ' '/
REG2.2005.ELCTECOA00.ELCCOA.ANNUAL.MEuro05 0.15
/

PARAMETER
NCAP_ITAX ' '/
REG2.2005.ELCNNNUC01.MEuro05 50
/

PARAMETER
NCAP_ISUB ' '/
REG2.2005.ELCNNNUC01.MEuro05 20
/

PARAMETER
COM_TAXNET ' '/
REG2.2005.ELC.ANNUAL.MEuro05 0.5
/

PARAMETER
COM_CSTPRD ' '/
REG2.2005.ELC.ANNUAL.MEuro05 0.05
/

PARAMETER
UC_FLO ' '/
ATT_PER.LHS.REG1.2005.ELCNNNUC01.ELC.ANNUAL 1
ATT_COST.LHS.REG2.2005.ELCTEGAS00.ELCGAS.ANNUAL 1
ATT_COST.LHS.REG2.2005.ELCTECOA00.ELCCOA.ANNUAL 1
ATT_CUM.LHS.REG1.2005.ELCTEGAS00.ELC.ANNUAL 1
/

PARAMETER
UC_ACT ' '/
ATT_PER.LHS.REG1.2005.ELCTECOA00.ANNUAL 1
ATT_COST.LHS.REG2.2005.ELCTECOA00.ANNUAL 1
ATT_CUM.LHS.REG1.2005.ELCTECOA00.ANNUAL 1
ATT_CUMP.LHS.REG1.2005.ELCTEGAS00.ANNUAL 1
ATT_CUMP.RHS.REG1.2005.ELCTECOA00.ANNUAL 10
/

PARAMETER
UC_NCAP ' '/
ATT_PER.LHS.REG1.2005.ELCNNNUC01 1
ATT_COST.LHS.REG2.2005.ELCNNNUC01 1
ATT_CSUM.RHS.REG1.2005.ELCNNNUC01 1
/

PARAMETER
UC_CAP ' '/
ATT_PER.LHS.REG1.2005.ELCREHYD00 1
ATT_CSUM.LHS.REG1.2005.ELCNNNUC01 1
/

PARAMETER
UC_COMPRD ' '/
ATT_PER.LHS.REG1.2005.ELC.ANNUAL 0.01
ATT_COST.LHS.REG2.2005.ELC.ANNUAL 1
ATT_CUM.LHS.REG1.2005.ELC.ANNUAL 0.1
/

PARAMETER
UC_COMNET ' '/
ATT_COST.LHS.REG2.2005.ELC.ANNUAL 1
ATT_CUM.LHS.REG1.2005.ELC.ANNUAL 0.1
/

PARAMETER
UC_IRE ' '/
ATT_PER.LHS.REG1.2005.MINCOA1.COA.ANNUAL.IMP 1
ATT_CUM.LHS.REG1.2005.MINCOA1.COA.ANNUAL.IMP 1
/

PARAMETER
UC_RHSRT ' '/
REG1.ATT_PER.0.UP 5
REG1.ATT_PER.2005.UP 100000
REG2.ATT_COST.0.UP 5
REG2.ATT_COST.2005.UP 10000000
REG1.ATT_CSUM.0.UP 5
REG1.ATT_CSUM.2005.UP 100
REG1.ATT_CUMP.0.UP 5
REG1.ATT_CUMP.2005.UP 100000
/

PARAMETER
UC_RHSR ' '/
REG1.ATT_CUM.UP 10000000
/
